# === סוכני AI (Anthropic) ===
# ללא מפתח המערכת רצה במצב דמו מלא — שום קריאה ל-API, עלות אפס.
# כשיהיה לך מפתח, הדבק אותו כאן והעתק קובץ זה ל-.env.local
ANTHROPIC_API_KEY=

# מודל ה-AI (אופציונלי). ברירת מחדל: claude-opus-4-8 (הכי חכם).
# לחיסכון: claude-haiku-4-5 (הזול ביותר) או claude-sonnet-5 (מאוזן).
AI_MODEL=claude-opus-4-8

# === Google Sheets (שלב 4 — סנכרון ידני) ===
# נתיב לקובץ ה-Service Account (JSON) שהורדת מ-Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=
# מזהה הגיליון (מתוך כתובת ה-URL של הגיליון)
GOOGLE_SHEET_ID=
# שם הלשונית לסנכרון נכסים
GOOGLE_SHEET_TAB=Listings
